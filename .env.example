# Copier en `.env`. Compose lit ce fichier pour ses substitutions ${...},
# et `node --env-file-if-exists=.env` pour un lancement hors conteneur.
# NODE_ENV n'est pas ici : les scripts dev/start la posent (cf. package.json).

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=zythologue
POSTGRES_USER=zythologue
POSTGRES_PASSWORD=zythologue

# Port publié sur l'hôte, et port de connexion du client pg hors conteneur.
POSTGRES_PORT=5432

# Hors conteneur uniquement : compose force `postgres` côté service api.
POSTGRES_HOST=localhost

# --- API --------------------------------------------------------------------
# Port sur lequel joindre l'API depuis la machine hôte, dans les deux modes :
# port d'écoute de server.js en local, port publié par compose en conteneur.
PORT=3000

# Secret de signature des JWT. Doit être déclaré dans compose.yaml
# (api.environment) pour être injecté dans le conteneur.
JWT_SECRET=change-me

# Origine du client autorisée par CORS, sans slash final.
# Non définie : http://localhost:${CLIENT_PORT} (défaut 5173).
# CORS_ORIGIN=http://localhost:5173

# --- Client -----------------------------------------------------------------
# URL de l'API vue par le navigateur. Non définie : http://localhost:${PORT}.
# VITE_API_URL=http://localhost:3000
