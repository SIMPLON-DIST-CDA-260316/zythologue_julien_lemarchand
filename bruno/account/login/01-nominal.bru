meta {
  name: Nominal
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "test.fixe@example.com",
    "password": "1234567!"
  }
}

assert {
  res.headers['set-cookie'][0]: contains token=
  res.headers['set-cookie'][0]: notContains token=undefined
}

settings {
  encodeUrl: true
  timeout: 0
}
