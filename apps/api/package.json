{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API Zythologue (Express).",
  "imports": {
    "#features/*": "./src/features/*",
    "#shared/*": "./src/shared/*",
    "#config/*": "./src/config/*",
    "#http/*": "./src/http/*",
    "#errors/*": "./src/errors/*"
  },
  "scripts": {
    "dev": "NODE_ENV=development nodemon --legacy-watch --watch src --watch server.js --exec \"node --env-file-if-exists=../../.env server.js\"",
    "start": "NODE_ENV=production node --env-file-if-exists=../../.env server.js",
    "test:bruno": "cd bruno && bru run . --env Local -r"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@usebruno/cli": "^4.2.0",
    "nodemon": "^3.1.10"
  }
}
