meta {
  name: Edge - mot de passe trop faible
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/users
  body: json
}

body:json {
  {
    "email": "test.{{ts}}@example.com",
    "password": "abcdefgh"
  }
}

script:pre-request {
  bru.setVar("ts", Date.now());
}

assert {
  res.status: eq 400
}

docs {
  EDGE — mot de passe sans chiffre ni caractère spécial → 400
}
