meta {
  name: Setup - crée le user B
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
}

body:json {
  {
    "email": "test.patch.b.{{tsB}}@example.com",
    "password": "{{testPassword}}"
  }
}

script:pre-request {
  bru.setVar("tsB", Date.now());
}

script:post-response {
  bru.setVar("userBId", res.body.data.id);
  bru.setVar("userBEmail", res.body.data.email);
}

assert {
  res.status: eq 201
}

docs {
  setup — user B, celui qui va tenter de patcher A pour le test 403
}
