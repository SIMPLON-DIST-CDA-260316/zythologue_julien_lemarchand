meta {
  name: Setup - connexion en tant que user A
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

body:json {
  {
    "email": "{{userAEmail}}",
    "password": "{{testPassword}}"
  }
}

assert {
  res.status: eq 200
  res.headers['set-cookie'][0]: contains token=
}

docs {
  setup — pose le cookie de session de A pour les scénarios suivants
}
