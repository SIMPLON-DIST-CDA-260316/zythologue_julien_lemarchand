meta {
  name: Setup - connexion
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

body:json {
  {
    "email": "{{meEmail}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
  res.headers['set-cookie'][0]: contains access_token=
}

docs {
  setup — pose le cookie de session pour le scénario nominal
}
