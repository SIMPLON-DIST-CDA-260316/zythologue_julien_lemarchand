@baseUrl = http://localhost:3000
@contentType = application/json
@id = 1

# Payload de création, partagé par les requêtes CREATE ci-dessous.
@name = Kwak
@description = brune belge
@alcoholContent = 8.4
@breweryId = 1
# Guillemets inclus : le body reçoit une string là où un number est attendu.
@invalidTypeId = "1"

# Toute réponse 2xx est enveloppée : charge utile sous `data`, plus `meta`
# pour les collections. Toute erreur rend `{ error }`, une string. Un 400 y
# ajoute `details`, un tableau de `{ path, message }` : `path` nomme le champ
# fautif en notation pointée, et reste vide quand l'erreur porte sur le corps
# entier.

### READ ALL — liste des bières → 200, { data: [...], meta: { total } }
GET {{baseUrl}}/beers?page=1

### READ ONE — une bière par id → 200, { data: {...} }
GET {{baseUrl}}/beers/{{id}}

### CREATE — sans body → 400, name et brewery_id manquants
POST {{baseUrl}}/beers
Content-Type: {{contentType}}

### CREATE — brewery_id manquant → 400
POST {{baseUrl}}/beers
Content-Type: {{contentType}}
j
{
  "name": "{{name}}",
  "description": "{{description}}",
  "alcohol_content": {{alcoholContent}}
}

### CREATE — brewery_id en string → 400, type attendu number
POST {{baseUrl}}/beers
Content-Type: {{contentType}}

{
  "name": "{{name}}",
  "description": "{{description}}",
  "alcohol_content": {{alcoholContent}},
  "brewery_id": {{invalidTypeId}}
}

### CREATE — nouvelle bière → 201
POST {{baseUrl}}/beers
Content-Type: {{contentType}}

{
  "name": "{{name}}",
  "description": "{{description}}",
  "alcohol_content": {{alcoholContent}},
  "brewery_id": {{breweryId}}
}

### UPDATE — modifier une bière par id
PUT {{baseUrl}}/beers/{{id}}

### DELETE — supprimer une bière par id
DELETE {{baseUrl}}/beers/{{id}}
