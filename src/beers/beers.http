@baseUrl = http://localhost:3000
@contentType = application/json
@id = 1

# Payload de création, partagé par les requêtes CREATE ci-dessous.
@name = Kwak
@description = brune belge
@alcoholContent = 8.4
@breweryId = 1
# Guillemets inclus : le body reçoit une string là où un number est attendu.
@invalidTypeId = "1"

# Toute réponse 2xx est enveloppée : charge utile sous `data`, plus `meta`
# pour les collections. Les erreurs ont deux formes distinctes : `{ errors }`
# sur un 400, le tableau des issues zod, et `{ error }` ailleurs, une string.

### READ ALL — liste des bières
GET {{baseUrl}}/beers

### READ ONE — une bière par id → 200, { data: {...} }
GET {{baseUrl}}/beers/{{id}}

### CREATE — sans body → 400, invalid_type sur name et brewery_id
POST {{baseUrl}}/beers
Content-Type: {{contentType}}

### CREATE — brewery_id manquant → 400, invalid_type sur brewery_id
POST {{baseUrl}}/beers
Content-Type: {{contentType}}

{
  "name": "{{name}}",
  "description": "{{description}}",
  "alcohol_content": {{alcoholContent}}
}

### CREATE — brewery_id en string → 400, invalid_type sur brewery_id
POST {{baseUrl}}/beers
Content-Type: {{contentType}}

{
  "name": "{{name}}",
  "description": "{{description}}",
  "alcohol_content": {{alcoholContent}},
  "brewery_id": {{invalidTypeId}}
}

### CREATE — nouvelle bière → 201
POST {{baseUrl}}/beers
Content-Type: {{contentType}}

{
  "name": "{{name}}",
  "description": "{{description}}",
  "alcohol_content": {{alcoholContent}},
  "brewery_id": {{breweryId}}
}

### UPDATE — modifier une bière par id
PUT {{baseUrl}}/beers/{{id}}

### DELETE — supprimer une bière par id
DELETE {{baseUrl}}/beers/{{id}}
